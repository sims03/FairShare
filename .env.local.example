# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API (or "Connect" button at the top).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). It is safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
